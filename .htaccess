<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Jika rute yang diminta adalah file atau direktori asli, biarkan saja
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Arahkan semua request lainnya ke index.php
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>